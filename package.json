{
  "name": "react-fabricjs-whiteboard",
  "version": "1.2.0",
  "description": "React whiteboard with PDF reader",
  "author": "Fauzan Siddiqui",
  "private": false,
  "license": "MIT",
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "main": "dist/index.js",
  "module": "dist/index.js",
  "keywords": [
    "react-whiteboard",
    "whiteboard",
    "fabricjs",
    "pdf"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FauzanMS/whiteboard.git"
  },
  "dependencies": {
    "@emotion/react": "^11.9.3",
    "@emotion/styled": "^11.9.3",
    "@mui/icons-material": "^5.8.4",
    "@mui/material": "^5.8.6",
    "fabric": "^7.4.0",
    "file-saver": "^2.0.5",
    "prop-types": "^15.8.1",
    "react-pdf": "^9.2.1",
    "sass": "^1.34.1",
    "sweetalert": "^2.1.2"
  },
  "peerDependencies": {
    "react": ">=17"
  },
  "devDependencies": {
    "@babel/cli": "^7.16.7",
    "@babel/core": "^7.16.7",
    "@babel/polyfill": "^7.12.1",
    "@babel/preset-env": "^7.18.2",
    "@babel/preset-react": "^7.17.12",
    "eslint": "^7.20.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-react": "^7.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-scripts": "^5.0.1"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "build-npm": "babel src/lib --out-dir dist --copy-files",
    "test": "react-scripts test",
    "copy-pdf-worker": "node scripts/copy-pdf-worker.js",
    "prestart": "npm run copy-pdf-worker && npm run make-sample-pdf",
    "prebuild": "npm run copy-pdf-worker && npm run make-sample-pdf",
    "make-sample-pdf": "node scripts/make-sample-pdf.js"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
